# ─── FitTrack Pro — Environment Variables ───────────────────────────────────
#
# Copy this file to .env.local for local development.
# In Vercel, add these as Environment Variables in your project settings.
# NEVER commit .env.local or any file containing real secrets to git.
#
# ─── Expo / EAS ──────────────────────────────────────────────────────────────

# Your Expo project ID (from expo.dev dashboard → Project Settings)
# EXPO_PUBLIC_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# EAS Update channel (for OTA updates, not required for static web builds)
# EXPO_PUBLIC_UPDATE_CHANNEL=production

# ─── App Config ──────────────────────────────────────────────────────────────

# Public base URL of the deployed app (used for deep-link generation)
# EXPO_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Analytics (optional) ────────────────────────────────────────────────────

# Vercel Analytics — automatically injected by Vercel, no key needed
# PostHog (if added later)
# EXPO_PUBLIC_POSTHOG_KEY=

# ─── Notes ───────────────────────────────────────────────────────────────────
# All client-side variables MUST be prefixed with EXPO_PUBLIC_ so that
# Expo Metro bundles them safely into the web build.
# Server-side-only secrets should NOT use this prefix and must never be
# accessed from client code.
